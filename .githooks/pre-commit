#!/bin/sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

sh "$REPO_ROOT/.githooks/_identity_guard.sh" current
sh "$REPO_ROOT/.githooks/_chain_global.sh" pre-commit "$@"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$STAGED" ] || exit 0

NEEDS_LINT=0
RUN_LINT_TESTS=0
NEEDS_DIFF_GUARD=0
OLD_IFS="$IFS"
IFS='
'
for relpath in $STAGED; do
    case "$relpath" in
        scripts/lint.py|scripts/test_lint.py)
            NEEDS_LINT=1
            RUN_LINT_TESTS=1
            ;;
        docs/process/README.md)
            NEEDS_LINT=1
            ;;
        docs/process/*)
            echo "pre-commit: 禁止提交过程文档目录产物 ($relpath)，仅允许 docs/process/README.md 入库" >&2
            exit 1
            ;;
        engines/cognee/*.py|scripts/*.py)
            NEEDS_LINT=1
            NEEDS_DIFF_GUARD=1
            ;;
        *.py)
            NEEDS_DIFF_GUARD=1
            ;;
        kit/ui/*.go|app/*.go|app/*/*.go)
            NEEDS_LINT=1
            NEEDS_DIFF_GUARD=1
            ;;
        internal/*.go|cmd/*.go|cmd/*/*.go|kit/*.go|kit/*/*.go|core/*.go|core/*/*.go|arch_guard_test.go)
            NEEDS_DIFF_GUARD=1
            ;;
        docs/*.md)
            NEEDS_LINT=1
            ;;
    esac
done
IFS="$OLD_IFS"

if [ "$NEEDS_LINT" -eq 0 ] && [ "$NEEDS_DIFF_GUARD" -eq 0 ]; then
    exit 0
fi

PYTHON_BIN="$REPO_ROOT/.local/cognee-python/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
    PYTHON_BIN="python3"
fi

if [ "$NEEDS_LINT" -eq 1 ]; then
    TMPDIR_INDEX="$(mktemp -d "${TMPDIR:-/tmp}/memlane-lint-index.XXXXXX")"
    trap 'rm -rf "$TMPDIR_INDEX"' EXIT INT TERM

    git checkout-index --all --prefix="$TMPDIR_INDEX/"
    "$PYTHON_BIN" "$TMPDIR_INDEX/scripts/lint.py"
    if [ "$RUN_LINT_TESTS" -eq 1 ]; then
        (cd "$TMPDIR_INDEX" && "$PYTHON_BIN" -m unittest discover -s scripts -p test_lint.py)
    fi
fi

if [ "$NEEDS_DIFF_GUARD" -eq 1 ] && [ -f "$REPO_ROOT/scripts/diff_guard.py" ]; then
    set -- --staged
    if [ -n "${MEMLANE_ALLOW_NEW_PY:-}" ]; then
        OLD_IFS="$IFS"
        IFS=','
        for pat in $MEMLANE_ALLOW_NEW_PY; do
            [ -n "$pat" ] || continue
            set -- "$@" --allow-new-py "$pat"
        done
        IFS="$OLD_IFS"
    fi
    "$PYTHON_BIN" "$REPO_ROOT/scripts/diff_guard.py" "$@"
fi
